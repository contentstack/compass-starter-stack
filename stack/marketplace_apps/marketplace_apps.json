    "manifest": {
      "uid": "6438f4bc3ff41c00184b6b78",
      "name": "AI Assistant",
      "description": "<p>Contentstack Marketplace lets you integrate the AI Assistant app to quickly and easily create summaries, outlines, metadata tags and descriptions, headlines, even full-length keyword-optimized blogs all with just a few clicks.</p><p>You can choose to generate, regenerate and replace content for the current field. Also, generate content for an entry field based on another field. You can also provide a custom command to manipulate the data based on your instructions.</p><p>With the Contentstack Entry Field UI location, you can access the AI Assistant app in different entry field types such as Title, Single Line Textbox, Multi-Line Textbox, HTML-based Rich Text Editor, JSON Rich Text Editor and Markdown.</p>",
      "icon": "https://eu-images.contentstack.com/v3/assets/blt8f94ebff857fe1ae/blt76b8f8e813f5c61f/64395e27ee6de97ed7d65bc5/AI-Assistant.svg",
      "ui_location": {
        "locations": [
          {
            "type": "cs.cm.stack.config",
            "meta": [
              {
                "uid": "64394fb77587664755d9b0ad",
                "path": "/#/app-configuration",
                "signed": true,
                "enabled": true,
                "required": true
              }
            ]
          },
          {
            "type": "cs.cm.stack.rte",
            "meta": [
              {
                "uid": "65029c5233e260b4b5489607",
                "name": "AI Assistant",
                "path": "/json-rte.js",
                "signed": true,
                "enabled": true,
                "description": "The JsonRTE Field plugin location allows you to use AI Assistant on selected content."
              }
            ]
          },
          {
            "type": "cs.cm.stack.field_modifier",
            "meta": [
              {
                "uid": "64394fce3ff9fd5bb4e72a3e",
                "name": "AI Assistant",
                "path": "/#/field-modifier",
                "signed": true,
                "enabled": true,
                "allowed_types": [
                  "text",
                  "tags",
                  "json"
                ],
                "description": "Entry Field UI location allows you to enable the AI Assistant app in different field types. "
              }
            ]
          }
        ]
      },
